{{ $supported_os := list "linux" "android" }}
{{ $supported_arch := list "amd64" "arm64" }}
{{ $tag := "v3.7c" }}

# source: https://github.com/tmux/tmux-builds

{{ define "amd64" }}
	url = "https://github.com/tmux/tmux-builds/releases/download/{{ .tag }}/tmux-{{ trimPrefix "v" .tag }}-linux-x86_64.tar.gz"
	checksum.sha512 = "1d98cb557207715f587b4dfef62061accd17db5b736a0782623dd6b751a0e1ef5aa5184703cb5272164718133f4f27c4a65a43baa761a72d742d7a2497dacc32"
{{ end }}

# ARM 64bit also called arm64, aarch64, armv8
{{ define "arm64" }}
	url = "https://github.com/tmux/tmux-builds/releases/download/{{ .tag }}/tmux-{{ trimPrefix "v" .tag }}-linux-arm64.tar.gz"
	checksum.sha512 = "088a69d67fe2da96635b68ca11fe32c3d72a7f3489555d097f49f1d79c624f5f85dbd5d959911dde16f3cbda88f7357822be6181665b89418711e03e731d9bb1"
{{ end }}

{{ define "sources" }}
	{{ if eq .chezmoi.arch "amd64" }}
		{{ template "amd64" . }}
	{{ else if eq .chezmoi.arch "arm64" }}
		{{ template "arm64" . }}
	{{ end }}
{{ end }}

{{ if and (has .chezmoi.os $supported_os) (has .chezmoi.arch $supported_arch) }}

# Tmux
[".local/bin.vendor.d/tmux"]
	type = "archive-file"
	path = "tmux"
	{{ template "sources" (dict "tag" $tag "chezmoi" .chezmoi) }}
	executable = true

{{ end }}

# vim: filetype=toml
