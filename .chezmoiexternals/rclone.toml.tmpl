{{/* Linux Go binaries could run on android, but android has blocked some syscalls (faccessat2) */}}
{{/* therefore special binaries built with GOOS=android are required. So android is not supported by default */}}
{{ $supported_os := list "linux" }}
{{ $supported_arch := list "amd64" "arm64" }}
{{ $tag := "v1.74.3" }}

# source: https://github.com/rclone/rclone

{{ define "amd64" }}
	url = "https://github.com/rclone/rclone/releases/download/{{ .tag }}/rclone-{{ .tag }}-linux-amd64.zip"
	checksum.sha512 = "dff5bb9d6eca8972b7b774204c521e068aecc6662b8ae052c6bbba89ccabbbf8d241506390356511455123c21c51900c5d62fd478136aafa16ea786554a42d45"
{{ end }}

# ARM 64bit also called arm64, aarch64, armv8
{{ define "arm64" }}
	url = "https://github.com/rclone/rclone/releases/download/{{ .tag }}/rclone-{{ .tag }}-linux-arm64.zip"
	checksum.sha512 = "937712edd94845311aad44e9e948e0af8e83b834092ddda19acecf9de9a01112718710ddaa7d18700656c7b30275f4ec000df6d469bafd78d66b8e241f13e0c1"
{{ end }}

{{ define "sources" }}
	{{ if eq .chezmoi.arch "amd64" }}
		{{ template "amd64" . }}
	{{ else if eq .chezmoi.arch "arm64" }}
		{{ template "arm64" . }}
	{{ end }}
{{ end }}

{{ if and (has .chezmoi.os $supported_os) (has .chezmoi.arch $supported_arch) }}

# Rclone
[".local/bin/rclone"]
	type = "archive-file"
	path = "rclone"
	{{ template "sources" (dict "tag" $tag "chezmoi" .chezmoi) }}
	stripComponents = 1
	executable = true
[".local/man/man1/rclone.1"]
	type = "archive-file"
	path = "rclone.1"
	{{ template "sources" (dict "tag" $tag "chezmoi" .chezmoi) }}
	stripComponents = 1

{{ end }}

# vim: filetype=toml
